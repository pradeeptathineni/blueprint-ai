{
  "reviewed": "2026-09-12",
  "baseline": "0.5.0 @ 60e0c41732e513d54353933c3e2882b54161e340",
  "interpretation": "Inherited gaps and final outcomes; platform availability is an observed environment snapshot, not certification.",
  "gaps": [
    {
      "area": "shared support registry",
      "classification": "implementation missing",
      "outcome": "implemented",
      "reason": "Canonical provider/tool/family data drives planning, execution metadata, doctor and generated support documentation."
    },
    {
      "area": "portable untrusted execution",
      "classification": "implementation missing",
      "outcome": "implemented",
      "reason": "Common OCI policy; Docker, Linux Podman and configured runsc adapters; never untrusted host fallback."
    },
    {
      "area": "native application and infrastructure families",
      "classification": "implementation missing",
      "outcome": "implemented",
      "reason": "Native representative families and three-cloud baselines; source publication and review share one executor."
    },
    {
      "area": "add to existing projects",
      "classification": "integration incomplete",
      "outcome": "implemented",
      "reason": "Pure content/hash/conflict plan plus the existing create-only transaction engine; parsed assets and exact directory-aware rollback."
    },
    {
      "area": "Conftest / ast-grep / Buf / SBOM output",
      "classification": "integration incomplete",
      "outcome": "wrapped/adapted",
      "reason": "Local configured rules and typed native output; Buf lint exit 100 and Syft inventory evidence handled separately."
    },
    {
      "area": "Maven / .NET / Pulumi / framework facts",
      "classification": "integration incomplete",
      "outcome": "deterministic inventory",
      "reason": "Bounded XML/YAML/dependency evidence; no build-script evaluation or inferred deployment."
    },
    {
      "area": "optional external scanners and toolchains",
      "classification": "optional external tool unavailable",
      "outcome": "explicit lifecycle",
      "reason": "Per-tool entries below distinguish managed OCI acquisition from official/project-native guidance."
    },
    {
      "area": "Ruby / C / C++ / Swift / Kotlin genesis",
      "classification": "unsupported ecosystem",
      "outcome": "unsupported initialization",
      "reason": "Language/file inventory is retained; no dedicated native generation/verifier matrix is advertised."
    },
    {
      "area": "Angular / Rust async API / Laravel / Symfony / Nx-Turbo generators",
      "classification": "intentionally deferred",
      "outcome": "native delegation / explicit deferral",
      "reason": "Dedicated builders, async behavior, database/plugin policies and task-engine combinations need independent fixtures; existing project inspection remains available."
    },
    {
      "area": "CDK / SAM / Bicep / azd / GCP Infrastructure Manager / Crossplane",
      "classification": "intentionally deferred",
      "outcome": "explicit deferral",
      "reason": "Terraform/OpenTofu/Pulumi cover local cloud baselines; account, schema, synthesis and deployment-specific fixtures remain separate."
    },
    {
      "area": "GraphQL / AsyncAPI / Pact / Schemathesis / API breaking and server generation",
      "classification": "integration incomplete",
      "outcome": "partial / explicit deferral",
      "reason": "OpenAPI/client generation and Buf lint are implemented; service contracts, baseline identities and authorized endpoints are not guessed."
    },
    {
      "area": "GitLab CI generation / hosted lint",
      "classification": "intentionally deferred",
      "outcome": "recognition only",
      "reason": "GitHub Actions remains the generated workflow default; no hosting APIs or remote writes are needed."
    },
    {
      "area": "browser / mutation / load / resilience / project-specific fuzz suites",
      "classification": "intentionally deferred",
      "outcome": "native project ownership",
      "reason": "Inventory and native script delegation are retained; generated smoke/contract tests do not claim business-journey coverage."
    },
    {
      "area": "rootless / Podman / runsc / Windows / file sharing",
      "classification": "environment-dependent",
      "outcome": "explicit platform boundary",
      "reason": "Live Docker Desktop checks plus common command contracts; no live Podman/runsc/native-Windows certification. Local engine resource controllers and shared bind paths are required."
    },
    {
      "area": "database-backed scanners / live DAST / model provider",
      "classification": "environment-dependent",
      "outcome": "explicit unavailable state",
      "reason": "Databases, authorized endpoints and live credentials are operator prerequisites. No live-model quality is claimed without calls."
    },
    {
      "area": "arbitrary remote hooks / curl-and-execute / implicit cloud or registry publication",
      "classification": "unsafe/unjustified",
      "outcome": "rejected",
      "reason": "Only registered operations execute; cloud provisioning and public publication are never defaults."
    },
    {
      "area": "destination network allowlists without enforcement",
      "classification": "unsafe/unjustified",
      "outcome": "rejected mode",
      "reason": "none/loopback are enforced; normal network requires explicit trust and authorization. No unenforced allowlist claim."
    },
    {
      "area": "bubblewrap / nsjail",
      "classification": "intentionally deferred",
      "outcome": "not implemented",
      "reason": "Linux namespace/seccomp/cgroup deployment and independent validation remain necessary."
    },
    {
      "area": "overlapping AST/SAST and vulnerability/Kubernetes scanner bundles",
      "classification": "duplicate capability already covered better elsewhere",
      "outcome": "configured alternatives",
      "reason": "Native AST/compiler facts remain authoritative; ast-grep/Semgrep run when configured. Grype/Kubescape are explicit alternatives to established routes."
    },
    {
      "area": "general manifest merges / codemods / migrations / remote template engines",
      "classification": "intentionally deferred",
      "outcome": "create-only boundary",
      "reason": "Avoid a second mutation engine; existing unsupported merges remain conflicts."
    },
    {
      "area": "semantic intent and name ranking",
      "classification": "intentionally deferred",
      "outcome": "bounded model surface unchanged",
      "reason": "Deterministic syntax, manifests and compiler facts stay model-free; architecture/test/documentation judgment retains bounded evidence and cache/call metrics."
    },
    {
      "area": "release signing / trusted publisher configuration",
      "classification": "environment-dependent",
      "outcome": "prepared documentation",
      "reason": "Build and local tag preparation are supported; registry/identity owners must configure their own OIDC publisher and authorize publication."
    }
  ],
